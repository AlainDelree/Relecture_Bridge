+    background: #f5e6c8;
+    color: #4a3418;
     font-weight: 700;
-    color: #1a1a1a;
+    line-height: 1;
+    border-radius: 3px;
+    border: 1px solid #caa02c;
+    box-shadow:
+        inset 1px 1px 0 rgba(255, 250, 230, 0.8),
+        inset -1px -1px 0 rgba(120, 80, 10, 0.65),
+        0 1px 2px rgba(0, 0, 0, 0.3);
 }
 
