   const el = document.getElementById("explorer-explanation");
-  if (!el) return;
-  el.textContent = (data && data.text) ? data.text : "";
+  if (el) el.textContent = (data && data.text) ? data.text : "";
+  explClearArrows();
+  if (data && data.arrows) explDrawArrows(data.arrows);
 });
 
