commit 46ee89a
Author: Athanatos123 <alain.delree@gmail.com>
Date:   Sun Aug 23 21:17:31 2026 +0200

    Extrait onclick/style inline de #screen-labo vers data-action + CSS — accordéon Config moteur (issue #239 partie 3/4)
    
    - Entête accordéon -> réutilise le case data-action="labo_toggle_section" (data-section="labo-sec-cfg")
    - laboSelectEngine('stockfish'/'maia') -> case unique data-action="labo_select_engine" paramétré
      par data-engine (2 boutons consolidés)
    - rodentCardClick('labo') -> réutilise directement le case data-action="rodent_card_click" (#235),
      juste data-context="labo" au lieu de "cfg", aucun nouveau case
    - laboAdjElo(-200/-50/50/200) -> case data-action="labo_adj_elo" paramétré par data-delta
      (4 boutons consolidés, distinct de adjustElo de #235)
    - laboAdjRodentElo(-200/-50/50/200) -> case distinct data-action="labo_adj_rodent_elo"
    - onchange (select Maia/Rodent, checkbox analyse) et oninput (laboClampElo/laboClampRodentElo)
      laissés tels quels (hors périmètre)
    - 33 style inline -> classes CSS (.labo-cfg-body, .labo-eng-btns, .labo-unavail-msg,
      .labo-rodent-dl-status, .labo-elo-row/-btn/-btn-wide/-input/-label/-label-spaced,
      .labo-select-tight, .labo-analyse-row/-label/-toggle/-checkbox/-activee) ; réutilise
      .labo-acc-card/-header/-title/-arrow déjà créés en #238 pour l'entête
    - 6 style="display:none;" conservés car fonctionnellement nécessaires : lecture/écriture de
      sec.style.display par laboToggleSection (état initial de l'accordéon) et pattern
      display="none"/"" (repli sur le cascade) dans laboSelectEngine et _apply*Availability
    
    Vérifié en direct (Playwright, serveur réel) : accordéon ouvre/ferme, sélection moteur
    Stockfish/Maia/Rodent, ajustement Elo Stockfish et Rodent dans les deux sens, checkbox
    analyse — aucune erreur console.
    Suite pytest complète (78 passed, 1 skipped, dont les 42 e2e) au vert.
    
    Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>

diff --git a/nicsoft/web/static/app.js b/nicsoft/web/static/app.js
index c1d74aa..a4e2f8f 100644
--- a/nicsoft/web/static/app.js
+++ b/nicsoft/web/static/app.js
@@ -190,6 +190,15 @@ document.addEventListener("click", (e) => {
     case "labo_toggle_section":
       laboToggleSection(el.dataset.section);
       break;
+    case "labo_select_engine":
+      laboSelectEngine(el.dataset.engine);
+      break;
+    case "labo_adj_elo":
+      laboAdjElo(parseInt(el.dataset.delta, 10));
+      break;
+    case "labo_adj_rodent_elo":
+      laboAdjRodentElo(parseInt(el.dataset.delta, 10));
+      break;
     case "labo_best_move":
       sendAction({ type: "best_move" });
       break;
