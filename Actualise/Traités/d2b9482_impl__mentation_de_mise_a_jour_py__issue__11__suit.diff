     version.json) et « Vérification SHA-256 du zip » dans le tableau
     « Décisions actées ».
     """
-    raise NotImplementedError
+    hachage = hashlib.sha256()
+    try:
+        with open(chemin_fichier, "rb") as f:
+            for bloc in iter(lambda: f.read(_TAILLE_BLOC_OCTETS), b""):
+                hachage.update(bloc)
