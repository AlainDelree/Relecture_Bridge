+def _url_https(depot: str) -> str:
+    """URL HTTPS du dépôt (jamais SSH — toute l'installation gh/bridge est en
+    HTTPS avec authentification `gh`, cf. §9 de la doc)."""
+    return f"https://github.com/{depot}.git"
