+        assert noms_etapes == [
+            "Répertoire de travail (contenu + dépôt git local)",
+            "Fichier .conf",
+            "Documentation",
+        ], noms_etapes
+        assert all(e["ok"] for e in res["etapes"]), res["etapes"]
+    return {"succes": res["succes"], "appels_regen": compteur.appels}
