+<!DOCTYPE html>
+<html lang="fr">
+<head>
+<meta charset="UTF-8">
+<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1, user-scalable=no">
+<title>BLOC FORMES</title>
+<link rel="preconnect" href="https://fonts.googleapis.com">
+<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
+<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600..900&family=IBM+Plex+Mono:wght@500;600&display=swap" rel="stylesheet">
+<style>
+  :root{
+    --ink: #241934;
+    --ink-2: #3a2647;
+    --ink-3: #2c1e3f;
+    --cream: #f3ead8;
+    --cream-dim: #cfc3ab;
+    --mustard: #e8a93a;
+    --teal: #3fa796;
+    --coral: #e85d4e;
+    --lav: #9b8bd6;
+    --line: rgba(243,234,216,0.14);
+  }
+  *{box-sizing:border-box;-webkit-tap-highlight-color:transparent;}
+  html,body{height:100%;}
+  body{
+    margin:0;
+    min-height:100vh;
+    background:
+      radial-gradient(circle at 15% 8%, rgba(232,169,58,0.10), transparent 45%),
+      radial-gradient(circle at 85% 92%, rgba(63,167,150,0.12), transparent 50%),
+      var(--ink);
+    color:var(--cream);
+    font-family:'IBM Plex Mono', monospace;
+    display:flex;
+    align-items:flex-start;
+    justify-content:center;
+    padding:28px 14px 60px;
+  }
+  .stage{width:100%;max-width:760px;}
+  header.hd{display:flex;align-items:baseline;justify-content:space-between;margin-bottom:14px;flex-wrap:wrap;gap:10px;}
+  .title{
+    font-family:'Fraunces', serif;
+    font-weight:900;
+    font-size:38px;
+    letter-spacing:-0.01em;
+    line-height:0.9;
+    color:var(--cream);
+    text-shadow: 3px 3px 0 var(--lav);
+  }
+  .title small{
+    display:block;
+    font-family:'IBM Plex Mono', monospace;
+    font-weight:600;
+    font-size:11px;
+    letter-spacing:0.18em;
+    color:var(--cream-dim);
+    text-shadow:none;
+    margin-top:4px;
+  }
+  .scores{text-align:right;font-size:12px;color:var(--cream-dim);}
+  .scores .num{
+    font-family:'Fraunces', serif;
+    font-weight:800;
+    font-size:30px;
+    color:var(--mustard);
+    display:block;
+    line-height:1;
+  }
+  .msg{
+    min-height:20px;
+    font-size:12px;
+    color:var(--coral);
+    margin-bottom:8px;
+    letter-spacing:0.02em;
+  }
+  .board-wrap{
+    background:var(--ink-2);
+    border-radius:14px;
+    padding:14px;
+    box-shadow: inset 0 0 0 1px var(--line);
+    overflow:auto;
+  }
+  svg#board{display:block;margin:0 auto;touch-action:manipulation;}
+  polygon.cell{
+    stroke:rgba(36,25,52,0.55);
+    stroke-width:1;
+    cursor:pointer;
+    transition:opacity .12s ease;
+  }
+  polygon.cell.preview-ok{stroke:var(--teal);stroke-width:2.4;}
+  polygon.cell.preview-bad{stroke:var(--coral);stroke-width:2.4;}
+  .reserve{
+    display:flex;
+    gap:10px;
+    margin-top:16px;
+    flex-wrap:wrap;
+  }
+  .piece-btn{
+    background:var(--ink-3);
+    border:2px solid transparent;
+    border-radius:10px;
+    padding:10px 14px;
+    color:var(--cream);
+    font-family:'IBM Plex Mono', monospace;
+    font-weight:600;
+    font-size:12px;
+    cursor:pointer;
+    display:flex;
+    align-items:center;
+    gap:8px;
+    letter-spacing:0.02em;
+  }
+  .piece-btn.active{border-color:var(--cream);}
+  .swatch{width:14px;height:14px;border-radius:3px;display:inline-block;}
+  .units{color:var(--cream-dim);font-size:10px;}
+  footer.ft{margin-top:16px;font-size:11px;color:var(--cream-dim);line-height:1.6;}
+</style>
+</head>
+<body>
+<div class="stage">
+  <header class="hd">
+    <div class="title">BLOC FORMES
+      <small>fondations — grille triangulaire · v0</small>
+    </div>
+    <div class="scores">
+      <span class="num" id="score">0</span>
+      score
+    </div>
+  </header>
+
+  <div class="msg" id="msg"></div>
+
+  <div class="board-wrap">
+    <svg id="board" xmlns="http://www.w3.org/2000/svg"></svg>
+  </div>
+
+  <div class="reserve" id="reserve"></div>
+
+  <footer class="ft">
+    Cliquez une pièce ci-dessus puis cliquez sur la grille pour la poser (le
+    triangle cliqué sert d'ancrage). Une zone se vide et rapporte 1 point
+    dès que tous ses triangles sont occupés.
+  </footer>
+</div>
+
+<script>
+(function(){
+  "use strict";
+
+  // ---------- Grille triangulaire ----------
+  const ROWS = 14, COLS = 18;
+  const CW = 30;                 // largeur de base d'un triangle
+  const CH = CW * Math.sqrt(3) / 2; // hauteur d'un triangle équilatéral
+  const PAD = 8;
+
+  function idx(r, c){ return r * COLS + c; }
+  function isUp(r, c){ return (r + c) % 2 === 0; }
+
+  const triangles = [];
+  for (let r = 0; r < ROWS; r++){
+    for (let c = 0; c < COLS; c++){
+      const x0 = c * (CW / 2);
+      const y0 = r * CH;
+      const up = isUp(r, c);
+      const points = up
+        ? [[x0, y0 + CH], [x0 + CW, y0 + CH], [x0 + CW / 2, y0]]
+        : [[x0, y0], [x0 + CW, y0], [x0 + CW / 2, y0 + CH]];
+      triangles.push({ id: idx(r, c), r, c, up, points });
+    }
+  }
+
+  function neighborsOf(r, c){
+    const up = isUp(r, c);
+    const list = [];
+    if (c > 0) list.push(idx(r, c - 1));
+    if (c < COLS - 1) list.push(idx(r, c + 1));
+    if (up) { if (r + 1 < ROWS) list.push(idx(r + 1, c)); }
+    else    { if (r - 1 >= 0) list.push(idx(r - 1, c)); }
+    return list;
+  }
+
+  // ---------- RNG déterministe (mulberry32) ----------
+  function mulberry32(seed){
+    return function(){
+      seed |= 0; seed = (seed + 0x6D2B79F5) | 0;
+      let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
+      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
+      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+    };
+  }
+  const rng = mulberry32(42);
+  function randInt(n){ return Math.floor(rng() * n); }
+
+  // ---------- Génération des zones de score ----------
+  // Chaque triangle peut appartenir à au plus 2 zones (chevauchement limité).
+  const cellZones = triangles.map(() => []);
+  const zones = [];
+
+  function growZone(targetSize){
+    const freeCells = triangles
+      .map(t => t.id)
+      .filter(id => cellZones[id].length === 0);
+    const looseCells = triangles
+      .map(t => t.id)
+      .filter(id => cellZones[id].length < 2);
+    const pool = freeCells.length ? freeCells : looseCells;
+    if (!pool.length) return null;
+    const start = pool[randInt(pool.length)];
+
+    const zoneCells = [];
+    const frontier = [start];
+    const inFrontier = new Set([start]);
+
+    while (zoneCells.length < targetSize && frontier.length){
+      const i = randInt(frontier.length);
+      const cellId = frontier.splice(i, 1)[0];
+      if (cellZones[cellId].length >= 2 || zoneCells.includes(cellId)) continue;
+      zoneCells.push(cellId);
+      const t = triangles[cellId];
+      for (const n of neighborsOf(t.r, t.c)){
+        if (!inFrontier.has(n) && cellZones[n].length < 2 && !zoneCells.includes(n)){
+          frontier.push(n);
+          inFrontier.add(n);
+        }
+      }
+    }
+    return zoneCells.length >= 3 ? zoneCells : null;
+  }
+
+  function zoneColor(i, total){
+    const hue = Math.round((i * 360) / total) % 360;
+    return `hsl(${hue} 60% 46%)`;
+  }
+
+  const ZONE_SPECS = [
+    { size: 6, count: 8 },
+    { size: 12, count: 5 },
+    { size: 24, count: 3 },
+  ];
+  const totalZonesPlanned = ZONE_SPECS.reduce((s, z) => s + z.count, 0);
+
+  ZONE_SPECS.forEach(spec => {
+    for (let n = 0; n < spec.count; n++){
+      let cells = null;
+      for (let attempt = 0; attempt < 5 && !cells; attempt++){
+        const candidate = growZone(spec.size);
+        if (candidate && (candidate.length >= spec.size * 0.6 || attempt === 4)){
+          cells = candidate;
+        }
+      }
+      if (!cells) continue;
+      const zoneId = zones.length;
+      const zone = { id: zoneId, cells, color: zoneColor(zoneId, totalZonesPlanned), size: cells.length };
+      zones.push(zone);
+      cells.forEach(id => cellZones[id].push(zoneId));
+    }
+  });
+
+  // ---------- Pièces ----------
+  const PIECES = {
+    triangle: { name: 'Triangle', color: '#e8a93a', cells: [[0,0]], parity: null },
+    losange:  { name: 'Losange',  color: '#3fa796', cells: [[0,0],[0,1]], parity: null },
+    hexagone: { name: 'Hexagone', color: '#9b8bd6', cells: [[0,0],[0,1],[0,2],[1,0],[1,1],[1,2]], parity: 0 },
+    etoile:   { name: 'Étoile',   color: '#e85d4e',
+      cells: [[0,0],[0,1],[0,2],[1,0],[1,1],[1,2],[0,-1],[-1,1],[0,3],[1,-1],[2,1],[1,3]],
+      parity: 0 },
+  };
+  const PIECE_ORDER = ['triangle', 'losange', 'hexagone', 'etoile'];
+
+  // ---------- État de jeu ----------
+  const occupied = new Array(triangles.length).fill(null); // null ou clé de pièce
+  let score = 0;
+  let selectedPiece = null;
+
+  function computeTargetCells(pieceKey, anchorR, anchorC){
+    const piece = PIECES[pieceKey];
+    if (piece.parity !== null && ((anchorR + anchorC) % 2) !== piece.parity){
+      return { ok: false, reason: 'parity' };
+    }
+    const targetCells = [];
+    for (const [dr, dc] of piece.cells){
+      const r = anchorR + dr, c = anchorC + dc;
+      if (r < 0 || r >= ROWS || c < 0 || c >= COLS){
+        return { ok: false, reason: 'bounds' };
+      }
+      const id = idx(r, c);
+      if (occupied[id]){
+        return { ok: false, reason: 'collision' };
+      }
+      targetCells.push(id);
+    }
+    return { ok: true, targetCells };
+  }
+
+  function tryPlace(pieceKey, anchorR, anchorC){
+    const res = computeTargetCells(pieceKey, anchorR, anchorC);
+    if (!res.ok) return res;
+    res.targetCells.forEach(id => { occupied[id] = pieceKey; });
+
+    const completed = zones.filter(z => z.cells.every(id => occupied[id]));
+    completed.forEach(z => { z.cells.forEach(id => { occupied[id] = null; }); });
+    if (completed.length){
+      score += completed.length; // 1 point fixe par zone vidée
+    }
+    return { ok: true, targetCells: res.targetCells, completed };
+  }
+
+  // ---------- Rendu SVG ----------
+  const svg = document.getElementById('board');
+  const maxX = (COLS - 1) * (CW / 2) + CW + PAD * 2;
+  const maxY = ROWS * CH + PAD * 2;
+  svg.setAttribute('viewBox', `0 0 ${maxX} ${maxY}`);
+  svg.setAttribute('width', Math.min(maxX, 720));
+  svg.setAttribute('height', maxY * (Math.min(maxX, 720) / maxX));
+
+  const defs = document.createElementNS('http://www.w3.org/2000/svg', 'defs');
+  svg.appendChild(defs);
+  const gradientCache = new Set();
+
+  function ensureGradient(zoneA, zoneB){
+    const [a, b] = [zoneA, zoneB].sort((x, y) => x - y);
+    const gid = `grad-${a}-${b}`;
+    if (!gradientCache.has(gid)){
+      const grad = document.createElementNS('http://www.w3.org/2000/svg', 'linearGradient');
+      grad.setAttribute('id', gid);
+      grad.setAttribute('x1', '0'); grad.setAttribute('y1', '0');
+      grad.setAttribute('x2', '1'); grad.setAttribute('y2', '1');
+      const s1 = document.createElementNS('http://www.w3.org/2000/svg', 'stop');
+      s1.setAttribute('offset', '50%'); s1.setAttribute('stop-color', zones[a].color);
+      const s2 = document.createElementNS('http://www.w3.org/2000/svg', 'stop');
+      s2.setAttribute('offset', '50%'); s2.setAttribute('stop-color', zones[b].color);
+      grad.appendChild(s1); grad.appendChild(s2);
+      defs.appendChild(grad);
+      gradientCache.add(gid);
+    }
+    return `url(#${gid})`;
+  }
+
+  const polyById = new Array(triangles.length);
+  triangles.forEach(t => {
+    const poly = document.createElementNS('http://www.w3.org/2000/svg', 'polygon');
+    poly.setAttribute('class', 'cell');
+    poly.setAttribute('points', t.points.map(p => `${p[0] + PAD},${p[1] + PAD}`).join(' '));
+    poly.dataset.id = t.id;
+    poly.dataset.r = t.r;
+    poly.dataset.c = t.c;
+    svg.appendChild(poly);
+    polyById[t.id] = poly;
+  });
+
+  function baseFillFor(id){
+    const zs = cellZones[id];
+    if (zs.length === 0) return 'rgba(243,234,216,0.06)';
+    if (zs.length === 1) return zones[zs[0]].color;
+    return ensureGradient(zs[0], zs[1]);
+  }
+
+  function render(){
+    triangles.forEach(t => {
+      const poly = polyById[t.id];
+      const occ = occupied[t.id];
+      poly.setAttribute('fill', occ ? PIECES[occ].color : baseFillFor(t.id));
+      poly.setAttribute('fill-opacity', occ ? '0.92' : (cellZones[t.id].length ? '0.55' : '1'));
+    });
+  }
+  render();
+
+  // ---------- Réserve de pièces ----------
+  const reserveEl = document.getElementById('reserve');
+  const btnByKey = {};
+  PIECE_ORDER.forEach(key => {
+    const p = PIECES[key];
+    const btn = document.createElement('button');
+    btn.className = 'piece-btn';
+    btn.innerHTML = `<span class="swatch" style="background:${p.color}"></span>${p.name} <span class="units">(${p.cells.length}u)</span>`;
+    btn.addEventListener('click', () => {
+      selectedPiece = (selectedPiece === key) ? null : key;
+      PIECE_ORDER.forEach(k => btnByKey[k].classList.toggle('active', k === selectedPiece));
+      clearPreview();
+    });
+    reserveEl.appendChild(btn);
+    btnByKey[key] = btn;
+  });
+
+  // ---------- Score / messages ----------
+  const scoreEl = document.getElementById('score');
+  const msgEl = document.getElementById('msg');
+  let msgTimer = null;
+  function showMsg(text){
+    msgEl.textContent = text;
+    clearTimeout(msgTimer);
+    msgTimer = setTimeout(() => { msgEl.textContent = ''; }, 1800);
+  }
+
+  // ---------- Prévisualisation au survol ----------
+  let previewIds = [];
+  function clearPreview(){
+    previewIds.forEach(id => polyById[id].classList.remove('preview-ok', 'preview-bad'));
+    previewIds = [];
+  }
+  function showPreview(anchorR, anchorC){
+    clearPreview();
+    if (!selectedPiece) return;
+    const res = computeTargetCells(selectedPiece, anchorR, anchorC);
+    const ids = res.ok ? res.targetCells : (
+      // même en cas d'échec, si les offsets restent dans la grille, montrer en rouge
+      PIECES[selectedPiece].cells
+        .map(([dr, dc]) => [anchorR + dr, anchorC + dc])
+        .filter(([r, c]) => r >= 0 && r < ROWS && c >= 0 && c < COLS)
+        .map(([r, c]) => idx(r, c))
+    );
+    const cls = res.ok ? 'preview-ok' : 'preview-bad';
+    ids.forEach(id => { polyById[id].classList.add(cls); previewIds.push(id); });
+  }
+
+  svg.addEventListener('mousemove', (e) => {
+    const el = e.target.closest('polygon.cell');
+    if (!el) { clearPreview(); return; }
+    showPreview(Number(el.dataset.r), Number(el.dataset.c));
+  });
+  svg.addEventListener('mouseleave', clearPreview);
+
+  svg.addEventListener('click', (e) => {
+    const el = e.target.closest('polygon.cell');
+    if (!el) return;
+    if (!selectedPiece){
+      showMsg('Sélectionnez d’abord une pièce dans la réserve.');
+      return;
+    }
+    const anchorR = Number(el.dataset.r), anchorC = Number(el.dataset.c);
+    const result = tryPlace(selectedPiece, anchorR, anchorC);
+    if (!result.ok){
+      const reasons = { collision: 'collision avec une pièce déjà posée', bounds: 'hors de la grille', parity: 'orientation invalide à cet endroit' };
+      showMsg('Placement impossible : ' + (reasons[result.reason] || result.reason));
+      return;
+    }
+    if (result.completed.length){
+      showMsg(`Zone${result.completed.length > 1 ? 's' : ''} vidée${result.completed.length > 1 ? 's' : ''} ! +${result.completed.length} pt${result.completed.length > 1 ? 's' : ''}`);
+    }
+    scoreEl.textContent = String(score);
+    render();
+    clearPreview();
+    showPreview(anchorR, anchorC);
+  });
+})();
+</script>
+</body>
+</html>
