+  -H "Authorization: Bearer <SECRET_ECRITURE>" \
+  -H "Content-Type: application/json" \
+  -d '{"nom":"x","mot_de_passe":"aaaaaaaaaaaa","token":"t"}'
+
+# Nettoyage (avec le maître)
+curl -s -X DELETE <URL>/api/test/ping -H "Authorization: Bearer <SECRET>"
