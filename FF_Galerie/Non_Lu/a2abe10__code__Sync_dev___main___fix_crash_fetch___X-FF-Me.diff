+<!DOCTYPE html>
+<html lang="fr">
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>Aperçu mur peinture</title>
+  <link rel="stylesheet" href="../../assets/css/style.css?v=20260626p">
+  <link rel="stylesheet" href="../../assets/css/galerie.css?v=20260708i">
+  <style>
+    /* Cette iframe rend UNIQUEMENT le mur d'expo (avec ses toiles).
+       Le décor (mur de la pièce + zone-basse + plancher) est construit
+       en CSS pur autour de l'iframe, dans admin-tdb.js → _creerCarteVue.
+       Cela permet un contrôle visuel précis sans dépendre du rendu
+       galerie-peinture.js qui a sa propre logique de layout. */
+    * { margin: 0; padding: 0; box-sizing: border-box; }
+    html, body { width: 100%; height: 100%; }
+    body { overflow: hidden; background: #2e2e2e; user-select: none; -webkit-user-select: none; pointer-events: none; }
+    .conteneur-salles { width: 100% !important; transform: none !important; height: 100vh !important; }
+    /* La salle = juste le mur d'expo qui remplit l'iframe (déjà au bon ratio
+       grâce au wrapper côté admin-tdb.js qui force l'aspect-ratio 12/8). */
+    .salle {
+      width: 100% !important; height: 100vh !important;
+      display: block !important;
+      padding: 0 !important;
+      background: transparent !important;
+    }
+    .mur, .mur.mur-grille {
+      width: 100% !important; height: 100% !important;
+      aspect-ratio: auto !important;
+      padding: 0 !important;
+      margin: 0 !important;
+    }
+    /* Cacher tout sauf le mur d'expo */
+    .zone-basse, .mur-inferieur, .plancher-sol,
+    .bandeau-invite, .entete, .nav-pages, .controles, .btn-musique,
+    .barre-navigation, .nav-mobile, .dots, .nav-retour, .retour-plan,
+    .panneau-nav, .plaque-nav, .galerie-footer, .nom-salle, .porte { display: none !important; }
+    /* Pas de clics */
+    .tableau, .cadre { cursor: default !important; pointer-events: none !important; }
+  </style>
+</head>
+<body class="theme-sombre" data-page="galerie">
+  <div class="conteneur-salles" id="conteneurSalles"></div>
+  <script>
+    window.GALERIE_TOILES_PATH = "data/oeuvres/peinture.json";
+    window.GALERIE_SALLES_PATH = "data/salles.json";
+    window.GALERIE_ASSETS_BASE = "../../";
+    var _vue = new URLSearchParams(location.search).get('vue');
+    window._GALERIE_FORCE_MOBILE = (_vue === 'gsm') ? true : (_vue === 'pc') ? false : null;
+    window._GALERIE_READONLY = true;
+  </script>
+  <script src="../../assets/js/galerie-core.js?v=20260713a"></script>
+  <script src="../../assets/js/galerie-peinture.js?v=20260707b"></script>
+  <script>
+    var _initDone = false;
+    function _doInit() { if (_initDone) return; _initDone = true; initGalerie(); }
+    window.addEventListener('message', function(e) {
+      if (e.data && e.data.type === 'init-data' && !_initDone) {
+        window._GALERIE_INJECTED = { toiles: e.data.toiles, salles: e.data.salles };
+        _doInit();
+      }
+    });
+    if (window.parent !== window) {
+      window.parent.postMessage({ type: 'iframe-awaiting-data' }, '*');
+      setTimeout(_doInit, 800);
+    } else {
+      _doInit();
+    }
+  </script>
+</body>
+</html>
