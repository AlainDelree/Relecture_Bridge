+<!DOCTYPE html>
+<html lang="fr">
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>Aperçu immersif</title>
+  <style>
+    * { margin: 0; padding: 0; box-sizing: border-box; }
+    body { background: #000; overflow: hidden; }
+    #imm-canvas { display: block; }
+  </style>
+</head>
+<body>
+  <canvas id="imm-canvas"></canvas>
+  <script>
+    window.GALERIE_CFG = { assetsBase: '../../' };
+    window.GALERIE_ASSETS_BASE = '../../';
+  </script>
+  <script src="../../assets/js/salle-immersive.js?v=20260710a"></script>
+  <script>
+    var _immCtrl = null;
+    var _pendingDecor = null; /* decor reçu avant que Three.js soit prêt */
+
+    window.addEventListener('message', function(e) {
+      if (!e.data) return;
+
+      if (e.data.type === 'immersive-init' && !_immCtrl) {
+        var canvas = document.getElementById('imm-canvas');
+        canvas.width  = window.innerWidth;
+        canvas.height = window.innerHeight;
+        renderImmersiveApercu(canvas, e.data.piece || {}, e.data.decor || {})
+          .then(function(ctrl) {
+            _immCtrl = ctrl;
+            /* Appliquer les couleurs qui ont changé pendant le chargement */
+            if (_pendingDecor) { _immCtrl.updateDecor(_pendingDecor); _pendingDecor = null; }
+          });
+      }
+
+      if (e.data.type === 'immersive-decor-update') {
+        if (_immCtrl) _immCtrl.updateDecor(e.data.decor || {});
+        else _pendingDecor = e.data.decor || {}; /* mettre en file d'attente */
+      }
+    });
+
+    /* Signaler au parent que la page est prête */
+    if (window.parent !== window) {
+      window.parent.postMessage({ type: 'immersive-awaiting-data' }, '*');
+    }
+  </script>
+</body>
+</html>
