+    * { margin: 0; padding: 0; box-sizing: border-box; }
+    body { overflow: hidden; background: #7a7a7a; user-select: none; -webkit-user-select: none; pointer-events: none; }
+    .conteneur-salles { width: 100% !important; height: 100% !important; flex: 1 1 auto !important; min-height: 0 !important; display: flex !important; flex-direction: column !important; transform: none !important; }
+    .salle {
+      width: 100% !important;
