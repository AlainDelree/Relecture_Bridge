+    window.GALERIE_SALLES_PATH = "data/salles.json";
+    window.GALERIE_ASSETS_BASE = "../../";
+    window._GALERIE_EDIT = true;
+    /* Forcer le mode d'affichage selon la vue demandée par l'admin (pc/gsm) */
